# YOLO: YOU ONLY LINK ONCE

# Clerk Authentication
# Get these from https://dashboard.clerk.com/last-active?path=api-keys
# Dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Prod
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk Custom Domain (Production only)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.yolo.aeronsystems.com/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://accounts.yolo.aeronsystems.com/sign-up
